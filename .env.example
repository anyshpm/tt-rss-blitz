# Local Compose test values. Do not commit real passwords.
TTRSS_DB_USER=postgres
TTRSS_DB_NAME=postgres
TTRSS_DB_PASS=change-this-long-random-password
ADMIN_USER_PASS=change-this-admin-password

# Local test:
TTRSS_SELF_URL_PATH=http://localhost:8080/tt-rss

# Optional:
# TTRSS_PLUGINS=auth_internal, note, nginx_xaccel
# PHP_WORKER_MAX_CHILDREN=5
# PHP_WORKER_MEMORY_LIMIT=256M
