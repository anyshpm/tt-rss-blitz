#!/bin/sh
while [ $# -gt 0 ]; do
    case "$1" in
        -u)
            shift
            if [ "$1" = "app" ]; then
                shift
            fi
            ;;
        -E|-Eu|-uE)
            shift
            if [ "$1" = "app" ]; then
                shift
            fi
            ;;
        -*)
            shift
            ;;
        *)
            break
            ;;
    esac
done
exec env "$@"
